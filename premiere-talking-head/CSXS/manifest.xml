<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0"
                   ExtensionBundleId="com.talkingheadtoolkit.panel"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Talking Head Toolkit"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.talkingheadtoolkit.panel.main" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO 13.0 = Premiere Pro CC 2019; open-ended upper bound -->
      <Host Name="PPRO" Version="[13.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.talkingheadtoolkit.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Talking Head Toolkit</Menu>
          <Geometry>
            <Size>
              <Height>620</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>280</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
